# Copy this file to .env.local and fill in real values. Vite only exposes
# variables prefixed with VITE_ to client-side code — see
# https://vite.dev/guide/env-and-mode.html

# OAuth Client ID for the optional Google Drive "Backup & Restore" feature
# (src/components/GoogleDriveSync.tsx). Create one at
# https://console.cloud.google.com/apis/credentials as a "Web application"
# OAuth client, with this site's origin(s) added under "Authorized JavaScript
# origins". Only the least-privileged `drive.appdata` scope is requested.
# Leave unset to keep the feature hidden/disabled.
VITE_GOOGLE_CLIENT_ID=
